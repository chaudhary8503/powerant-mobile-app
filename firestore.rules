rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read today's parameters (the app needs this with no login).
    // Only a signed-in user (your admin account) can change them.
    match /settings/daily {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
